---
import site from '../../config/site.config.json';
const socials = [
  { name:'Instagram', url:site.link_instagram },
  { name:'Snapchat', url:site.link_snapchat },
  { name:'TikTok', url:site.link_tiktok }
];
---
<nav class="social-row" aria-label="Social profiles">
  {socials.map(item => { const Tag = item.url ? "a" : "span"; return <Tag class="social-link" href={item.url || undefined} target={item.url ? "_blank" : undefined} rel={item.url ? "noopener noreferrer" : undefined} aria-label={item.url ? `Open ${item.name} in a new tab` : `${item.name} link not yet configured`}>
    {item.name === 'Instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".9" fill="white" stroke="none"/></svg>}
    {item.name === 'Snapchat' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c3.25 0 4.5 2.4 4.5 5.3v2.15c.4-.15.7-.34 1.25-.2.6.15.72.7.5 1.08-.2.32-.92.42-1.4.64-.56.27-.35.82.2 1.43.7.8 1.7 1.5 2.8 1.8-.35.82-1.08 1.02-2.1 1.17-.45.06-.61.58-.82 1.25-.69-.1-1.36-.3-2.17-.14-.97.19-1.65 1.1-2.76 1.1s-1.79-.91-2.76-1.1c-.81-.16-1.48.04-2.17.14-.21-.67-.37-1.19-.82-1.25-1.02-.15-1.75-.35-2.1-1.17 1.1-.3 2.1-1 2.8-1.8.55-.61.76-1.16.2-1.43-.48-.22-1.2-.32-1.4-.64-.22-.38-.1-.93.5-1.08.55-.14.85.05 1.25.2V8.3C7.5 5.4 8.75 3 12 3Z"/></svg>}
    {item.name === 'TikTok' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 2.5c.23 3.1 2.1 4.8 5.1 5v3.35c-2.05.04¶»§q«^