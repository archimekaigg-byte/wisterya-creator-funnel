---
import site from '../../config/site.config.json';
const socials = [
  { name: 'Instagram', url: site.link_instagram },
  { name: 'Snapchat', url: site.link_snapchat },
  { name: 'TikTok', url: site.link_tiktok }
];
---
<nav class="social-row" aria-label="Social profiles">
  {socials.map((item) => item.url ? (
    <a class="social-link" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.name}>{item.name}</a>
  ) : (
    <span class="social-link" aria-label={item.name + ' link not configured'}>{item.name}</span>
  ))}
</nav>
