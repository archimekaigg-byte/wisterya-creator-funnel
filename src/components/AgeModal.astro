---
import site from '../../config/site.config.json';
const siteKey = import.meta.env.TURNSTILE_SITE_KEY || site.turnstile_site_key;
---
<div class="age-overlay" id="age-overlay" data-sitekey={siteKey} data-back={`/${site.slug}`} hidden>
  <section class="age-dialog" id="age-dialog" role="dialog" aria-modal="true" aria-labelledby="age-title" aria-describedby="age-description" tabindex="-1">
    <h2 id="age-title">Are you over 18?</h2>
    <p id="age-description">This link contains content for adults only. Please confirm you are 18 or older to continue.</p>
    <form action="/api/age-confirm" method="POST" id="age-form" novalidate>
      <input type="hidden" name="slug" value={site.slug} />
      <input type="hidden" name="token" id="age-token" />
      <input type="hidden" name="fbclid" id="age-fbclid" />
      <div class="age-widget" id="turnstile-widget" aria-label="Cloudflare verification"></div>
      <p class="age-status" id="age-status" aria-live="polite"></p>
      <div class="age-actions">
        <button class="primary-button" type="submit" id="confirm-age" disabled>Yes, I'm over 18</button>
        <a class="secondary-button" href={`/${site.slug}`} id="decline-age">No, take me back</a>
      </div>
    </form>
  </section>
</div>
<script src="../scripts/age-modal.js"></script>