---
import site from '../../../config/site.config.json';
import Layout from '../../components/Layout.astro';
import ProfileCard from '../../components/ProfileCard.astro';
import Footer from '../../components/Footer.astro';
export const getStaticPaths = () => [{params:{slug:site.slug}}];
---
<Layout title={`${site.nome} | Chat`} description={site.testo_pagina_2} image={site.foto_b} robots="noindex,nofollow" canonicalPath={`/go/${site.slug}`}>
  <main class="site-shell page-two">
    <div class="content">
      <ProfileCard second={true} />
      <p class="page-two-copy">{site.testo_pagina_2}</p>
      <div class="cta-wrap"><a class="primary-button" id="fanvue-link" href={site.url_destinazione} rel="noopener noreferrer" aria-disabled="true" tabindex="-1" style="pointer-events:none;opacity:.5">{site.testo_bottone_2}</a></div>
    </div>
    <Footer />
  </main>

  <div class="age-overlay" id="age-overlay">
    <section class="age-dialog" role="dialog" aria-modal="true" aria-labelledby="age-title" aria-describedby="age-description">
      <h2 id="age-title">Are you over 18?</h2>
      <p id="age-description">This link contains content for adults only. Please confirm you are 18 or older to continue.</p>
      <div class="age-actions">
        <button class="primary-button" type="button" id="confirm-age" style="min-height:44px">Yes, I'm over 18</button>
        <a class="secondary-button" href={`/${site.slug}`} style="min-height:44px">No, take me back</a>
      </div>
    </section>
  </div>
  <style>#age-overlay[hidden]{display:none!important;pointer-events:none!important}</style>
  <script is:inline>
    (function () {
      function initializeAgeGate() {
        try {
          var overlay = document.getElementById('age-overlay');
          var confirmButton = document.getElementById('confirm-age');
          var link = document.getElementById('fanvue-link');
          if (!overlay || !confirmButton || !link) return;
          var key = 'age-confirmed:' + window.location.pathname;
          function unlock() {
            overlay.hidden = true;
            overlay.style.display = 'none';
            overlay.style.pointerEvents = 'none';
            document.body.style.overflow = '';
            link.style.pointerEvents = 'auto';
            link.style.opacity = '1';
            link.removeAttribute('aria-disabled');
            link.removeAttribute('tabindex');
          }
          try {
            if (window.sessionStorage.getItem(key) === 'yes') unlock();
          } catch (error) { /* Session storage may be blocked. */ }
          confirmButton.addEventListener('click', function (event) {
            event.preventDefault();
            unlock();
            try { window.sessionStorage.setItem(key, 'yes'); } catch (error) {}
          }, false);
        } catch (error) {
          console.error('Age gate initialization failed', error);
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeAgeGate, { once: true });
      } else {
        initializeAgeGate();
      }
    })();
  </script>
  <script>
    const data=JSON.stringify({event:'page_two',referrer:document.referrer});
    if (navigator.sendBeacon) navigator.sendBeacon('/api/events',new Blob([data],{type:'text/plain'}));
  </script>
</Layout>
